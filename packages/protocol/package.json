{
  "name": "@pokemon-chess/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Client ↔ server message contract: Zod schemas for every client intent, shared server types.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pokemon-chess/engine": "workspace:*",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  }
}
