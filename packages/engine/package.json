{
  "name": "@pokemon-chess/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript rules engine for Pokémon Chess. No UI or network dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@pkmn/dex": "^0.10.0",
    "vitest": "^3.2.0"
  }
}
